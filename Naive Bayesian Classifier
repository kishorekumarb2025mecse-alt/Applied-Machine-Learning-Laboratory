# ──────────────────────────────────────────────────────────────
#  PART A — NAÏVE BAYES CLASSIFIER FROM SCRATCH
# ──────────────────────────────────────────────────────────────

class NaiveBayesClassifier:
    """
    Categorical Naïve Bayes Classifier with Laplace (Add-1) Smoothing.

    Bayes' Theorem:
        P(class | x₁…xₙ) ∝ P(class) × ∏ P(xᵢ | class)

    Laplace Smoothing (avoids zero probabilities):
        P(xᵢ=v | class) = (count(xᵢ=v, class) + 1)
                          ──────────────────────────────
                          (N_class + |unique_values(xᵢ)|)
    """

    def __init__(self, laplace: bool = True):
        self.laplace      = laplace
        self.priors       = {}      # P(class)
        self.likelihoods  = {}      # P(feature=value | class)
        self.classes      = []
        self.features     = []
        self.vocab        = {}      # Unique values per feature

    # ── Training ──────────────────────────────────────────────
    def fit(self, X: pd.DataFrame, y: pd.Series):
        self.classes  = list(y.unique())
        self.features = list(X.columns)
        N             = len(y)

        for feat in self.features:
            self.vocab[feat] = list(X[feat].unique())

        # Step 1 — Prior Probabilities: P(class)
        for cls in self.classes:
            self.priors[cls] = int((y == cls).sum()) / N

        # Step 2 — Likelihood Probabilities: P(feat=val | class)
        for feat in self.features:
            k = len(self.vocab[feat])          # Vocabulary size for smoothing
            self.likelihoods[feat] = {}

            for cls in self.classes:
                subset  = X[y == cls][feat]
                n_cls   = len(subset)
                self.likelihoods[feat][cls] = {}

                for val in self.vocab[feat]:
                    cnt = int((subset == val).sum())
                    if self.laplace:
                        self.likelihoods[feat][cls][val] = (cnt + 1) / (n_cls + k)
                    else:
                        self.likelihoods[feat][cls][val] = cnt / n_cls if n_cls else 0
        return self

    # ── Inference ─────────────────────────────────────────────
    def _raw_scores(self, row: pd.Series) -> dict:
        scores = {}
        for cls in self.classes:
            p = self.priors[cls]
            for feat in self.features:
                p *= self.likelihoods[feat][cls].get(row[feat], 1e-9)
            scores[cls] = p
        return scores

    def predict_proba(self, X: pd.DataFrame) -> pd.DataFrame:
        """Return normalised posterior probability for each class."""
        rows = []
        for _, row in X.iterrows():
            raw   = self._raw_scores(row)
            total = sum(raw.values()) or 1
            rows.append({c: v / total for c, v in raw.items()})
        return pd.DataFrame(rows, columns=self.classes)

    def predict(self, X: pd.DataFrame) -> list:
        """Return predicted class label for each sample."""
        return self.predict_proba(X).idxmax(axis=1).tolist()

    def accuracy(self, X: pd.DataFrame, y: pd.Series) -> float:
        return sum(p == a for p, a in zip(self.predict(X), y)) / len(y)

    # ── Display Learned Probability Tables ────────────────────
    def display_probability_tables(self, X: pd.DataFrame, y: pd.Series):
        N = len(y)

        print("\n" + "=" * 65)
        print("  STEP 1 — PRIOR PROBABILITIES  P(Product Quality)")
        print("=" * 65)
        for cls in self.classes:
            cnt = int((y == cls).sum())
            print(f"  P({cls:<12}) = {cnt}/{N} = {self.priors[cls]:.4f}")

        print("\n" + "=" * 65)
        print("  STEP 2 — LIKELIHOOD TABLE  P(Feature = value | Class)")
        print("=" * 65)
        cls0, cls1 = self.classes[0], self.classes[1]
        for feat in self.features:
            print(f"\n  ── {feat} ──")
            print(f"  {'Value':<12}  {f'P(·|{cls0})':>16}  {f'P(·|{cls1})':>14}")
            print(f"  {'─'*12}  {'─'*16}  {'─'*14}")
            for val in self.vocab[feat]:
                p0 = self.likelihoods[feat][cls0][val]
                p1 = self.likelihoods[feat][cls1][val]
                print(f"  {val:<12}  {p0:>16.4f}  {p1:>14.4f}")


