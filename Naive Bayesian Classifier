print("  CONFUSION MATRIX")
print("=" * 65)

cm = defaultdict(int)
for a, p in zip(y, preds):
    cm[(a, p)] += 1

cls0, cls1 = model.classes
print(f"\n  {'':22} {'Pred: '+cls0:<22} {'Pred: '+cls1}")
print("  " + "─" * 60)
for actual_cls in model.classes:
    row = "  " + f"  {'Act: '+actual_cls:<20}"
    for pred_cls in model.classes:
        row += f"  {cm[(actual_cls, pred_cls)]:<20}"
    print(row)

print(f"\n  Interpretation:")
print(f"  TP (Defective → Defective) = {cm[('Defective','Defective')]}")
print(f"  TN (Good      → Good)      = {cm[('Good','Good')]}")
print(f"  FP (Good  → Defective)     = {cm[('Good','Defective')]}")
print(f"  FN (Defective → Good)      = {cm[('Defective','Good')]}")


# ──────────────────────────────────────────────────────────────
#  PRECISION / RECALL / F1
# ──────────────────────────────────────────────────────────────
print("\n" + "=" * 65)
print("  CLASSIFICATION METRICS")
print("=" * 65)
print(f"\n  {'Class':<14} {'Precision':>12} {'Recall':>10} {'F1-Score':>10} {'Support':>10}")
print(f"  {'─'*14} {'─'*12} {'─'*10} {'─'*10} {'─'*10}")

f1_scores = []
for cls in model.classes:
    tp = cm[(cls, cls)]
    fp = sum(cm[(o, cls)] for o in model.classes if o != cls)
    fn = sum(cm[(cls, o)] for o in model.classes if o != cls)
    support = tp + fn

    prec   = tp / (tp + fp) if (tp + fp) else 0.0
    recall = tp / (tp + fn) if (tp + fn) else 0.0
    f1     = 2 * prec * recall / (prec + recall) if (prec + recall) else 0.0
    f1_scores.append(f1)

    print(f"  {cls:<14} {prec:>12.4f} {recall:>10.4f} {f1:>10.4f} {support:>10}")

print(f"\n  {'─'*58}")
print(f"  {'Overall Accuracy':<30} {acc:.4f}  ({acc:.2%})")
print(f"  {'Macro-Avg F1-Score':<30} {np.mean(f1_scores):.4f}")


