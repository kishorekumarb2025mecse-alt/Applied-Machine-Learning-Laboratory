Python Program
# Naive Bayes Classifier using Industrial Manufacturing Dataset

from sklearn.preprocessing import LabelEncoder
from sklearn.naive_bayes import CategoricalNB
from sklearn.metrics import accuracy_score
import pandas as pd

# Dataset from the question
data = {
    'Machine_Type': ['CNC', 'CNC', 'Lathe', 'Milling', 'Lathe'],
    'Temperature': ['High', 'Normal', 'Normal', 'High', 'Normal'],
    'Vibration': ['High', 'Low', 'Low', 'High', 'High'],
    'Shift': ['Night', 'Day', 'Day', 'Night', 'Day'],
    'Product_Quality': ['Defective', 'Good', 'Good', 'Defective', 'Good']
}

df = pd.DataFrame(data)

# Encoding categorical data
encoders = {}
for col in df.columns:
    le = LabelEncoder()
    df[col] = le.fit_transform(df[col])
    encoders[col] = le

# Features and Target
X = df[['Machine_Type', 'Temperature', 'Vibration', 'Shift']]
y = df['Product_Quality']

# Train Naive Bayes Classifier
model = CategoricalNB()
model.fit(X, y)

# Testing on the same dataset
y_pred = model.predict(X)

# Accuracy
accuracy = accuracy_score(y, y_pred)

print("Predicted Labels:", y_pred)
print("Actual Labels   :", list(y))
print("Accuracy =", accuracy * 100, "%")

# Sample Test Data
sample = pd.DataFrame({
    'Machine_Type': ['CNC'],
    'Temperature': ['High'],
    'Vibration': ['High'],
    'Shift': ['Night']
})

# Encode sample data
for col in sample.columns:
    sample[col] = encoders[col].transform(sample[col])

prediction = model.predict(sample)

result = encoders['Product_Quality'].inverse_transform(prediction)

print("\nSample Prediction:", result[0])
